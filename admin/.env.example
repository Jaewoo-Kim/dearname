# admin/.env.local 로 복사해서 채우세요 (Vercel에서는 프로젝트 환경변수로 등록)

# Supabase 프로젝트 설정 → API 메뉴에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# 로그인 허용 운영자 이메일 (쉼표로 구분). 비워두면 로그인한 모든 계정 허용(개발용, 운영 전 반드시 설정).
ADMIN_ALLOWED_EMAILS=owner@dearname.kr

# 환불(STEP 5) 전용 — 절대 NEXT_PUBLIC_ 접두사를 붙이지 말 것 (서버 Route Handler 전용, 브라우저 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=eyJ...
TOSS_SECRET_KEY=test_sk_...

# 본 서비스(dearname) 배포 주소 — "디어네임에서 열기" 버튼이 report-view.html로 이동할 때 사용
NEXT_PUBLIC_DEARNAME_SITE_URL=https://dearname.onrender.com
